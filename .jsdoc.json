{
  "opts": {
    "destination": "jsdoc",
    "readme": "api.md",
    "recurse": true,
    "siteName": "Marpit API",
    "template": "node_modules/clean-jsdoc-theme/dist",
    "sectionOrder": ["Classes", "Modules"],
    "menu": [
      {
        "title": "Marpit docs",
        "link": "https://marpit.marp.app/",
        "target": "_blank"
      }
    ],
    "markdown": {
      "idInHeadings": true
    }
  },
  "plugins": ["plugins/markdown"]
}
